# AccessAble AI - Environment Configuration Example
# Copy this file to .env to customize settings

# Flask settings
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
FLASK_DEBUG=0

# Ollama Local Service
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=moondream
OLLAMA_REQUEST_TIMEOUT=90

# Upload Limits
MAX_PDF_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_HTML_SIZE_MB=5
MAX_TEXT_INPUT_CHARS=25000

# OCR Configuration (Optional, set path if tesseract is installed in custom path)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
